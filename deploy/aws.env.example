# Copy to deploy/aws.env (gitignored) — or run ./infra/aws/bootstrap.sh to generate.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

S3_BUCKET_RAW=capstone-123456789012-raw
S3_BUCKET_ARTIFACTS=capstone-123456789012-artifacts

# Set EC2_ENABLED=true after bootstrap creates an instance.
EC2_ENABLED=false
EC2_INSTANCE_ID=
EC2_KEY_PATH=$HOME/.ssh/capstone-staging.pem
EC2_SSH_USER=ec2-user

CAPSTONE_GIT_REPO=https://github.com/dcosta224/Capstone.git
CAPSTONE_BRANCH=staging
CAPSTONE_ROOT=/opt/capstone
